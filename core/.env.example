PROJECT_NAME="SecureSign Core Engine"
VERSION=0.1.0
APP_PORT=8000
APP_ENV=development

# Demo-only defaults. Replace both values in production.
ENCRYPTION_KEY=uO12M9L4hN4b6s4mXqK_3jJ_n-pXGvL9QvO2zZqE2y0=
SECRET_KEY=securesign-demo-only-secret-key-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:3000
DEFAULT_MONTHLY_SIGNING_LIMIT=1000
MAX_UPLOAD_SIZE=20971520

# Local development database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securesign-demo-db-password
POSTGRES_DB=digital_signature_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:change-this-password@localhost:5432/digital_signature_db

TSA_URL=http://timestamp.digicert.com
